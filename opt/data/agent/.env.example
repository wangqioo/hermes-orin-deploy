# Hermes Agent 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# DeepSeek API Key（主模型）
# 获取地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：其他 LLM 提供商
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# 终端工具配置
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300

# 调试选项
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
